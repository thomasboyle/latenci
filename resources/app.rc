#include "resource.h"

IDI_APP ICON "app.ico"

// Subset of Monocraft.ttf (kept alongside as the source). Regenerate with:
//   python -m fontTools.subset Monocraft.ttf ^
//     --unicodes="U+0020-007E,U+00A0-00FF,U+2013-2014" --layout-features="kern" ^
//     --drop-tables+=STAT --no-glyph-names --name-IDs="1,2,3,4,6,16,17" ^
//     --output-file=Monocraft.subset.ttf
IDR_FONT_MONOCRAFT RCDATA "fonts\\Monocraft.subset.ttf"
